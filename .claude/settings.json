      "Bash(pnpm remove:*)",
      "Bash(pip uninstall -y:*)",
      "Bash(cargo uninstall:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(kill -9 -1)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "(test -f \"$CLAUDE_FILE_PATH\" && (file=\"$CLAUDE_FILE_PATH\"; case \"$file\" in *.py) python -m ruff format --silent \"$file\" 2>/dev/null || python -m black -q \"$file\" 2>/dev/null ;; *.ts|*.tsx|*.js|*.jsx|*.json|*.md|*.yml|*.yaml) npx --silent prettier --write \"$file\" 2>/dev/null ;; *.go) gofmt -w \"$file\" 2>/dev/null ;; *.rs) rustfmt \"$file\" 2>/dev/null ;; esac)) || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_TOOL_INPUT\" | grep -qE '(rm -rf|chmod 777|--no-verify|push --force|push -f|reset --hard|git clean -fd|sudo|curl [^|]+\\| ?sh|wget [^|]+\\| ?sh|filter-branch|filter-repo|terraform destroy|kubectl delete|aws s3 rm|aws s3 sync --delete|:\\(\\)\\s*\\{)' && (echo '\ud83d\uded1 BLOCKED: dangerous command pattern detected' >&2; exit 1) || exit 0"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000"
  }
}